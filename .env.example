# Copia este fichero a `.env` y ajusta los valores en la VM de despliegue.

# Puerto en el que escucha la API.
PORT=3000

# Secreto para firmar los JWT. GENERA UNO NUEVO Y ÚNICO en producción, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=elTokenVaAqui

# Caducidad de los tokens.
JWT_EXPIRES_IN=24h

# Certificado HTTPS. Si se omiten ambas variables, el servidor arranca en HTTP.
# En producción usa un certificado real (Let's Encrypt o emitido por la UO);
# el autofirmado de ./certs solo es válido para desarrollo.
SSL_KEY=./certs/key.pem
SSL_CERT=./certs/cert.pem
