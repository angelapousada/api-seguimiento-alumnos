# Puerto en el que escucha la API
PORT=3000

# Clave para firmar los tokens JWT (OBLIGATORIA: el servidor no arranca sin ella).
# Usa un valor largo y aleatorio; cámbialo en producción.
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# Caducidad de los tokens (formato de la librería jsonwebtoken).
JWT_EXPIRES_IN=24h

# HTTPS con certificado autofirmado. Si defines ambas variables, el servidor
# arranca por HTTPS; si las dejas vacías o las quitas, arranca por HTTP.
SSL_KEY=./certs/key.pem
SSL_CERT=./certs/cert.pem

# Nota: la base de datos es SQLite (better-sqlite3) y se crea automáticamente
# en data/seguimiento.db. No requiere ninguna variable de conexión.
