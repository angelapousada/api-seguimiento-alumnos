[Unit]
# Servicio systemd para arrancar la API al iniciar la VM y reiniciarla ante fallos.
# Instalación (en la VM, como root):
#   1) Ajusta User, WorkingDirectory y ExecStart a la ruta real del despliegue.
#   2) sudo cp deploy/api-seguimiento.service /etc/systemd/system/
#   3) sudo systemctl daemon-reload
#   4) sudo systemctl enable --now api-seguimiento
#   Ver logs:  journalctl -u api-seguimiento -f
Description=API Seguimiento de Alumnos (Node/Express)
After=network.target

[Service]
Type=simple
# Usuario sin privilegios propietario del directorio de la app (NO root).
User=seguimiento
Group=seguimiento
# Ruta absoluta del proyecto en la VM (debe contener .env, certs/, data/).
WorkingDirectory=/opt/api-seguimiento-alumnos
# Ruta absoluta a node (comprueba con `which node`).
ExecStart=/usr/bin/node src/app.js
Restart=on-failure
RestartSec=5
# El proceso lee la configuración de .env (vía dotenv) desde WorkingDirectory.
Environment=NODE_ENV=production
# Endurecimiento básico.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
